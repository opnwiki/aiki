# AIKI node configuration. Copy to .env (or run `npm run setup:local`, which
# fills the three secrets below with fresh random values) and never commit .env.

# --- Database (required) ---
POSTGRES_DB=aiki
POSTGRES_USER=aiki
POSTGRES_PASSWORD=change-this-password
# Used by `npm run dev`, `npm run db:migrate` and scripts outside Docker.
# Inside Compose, the app builds its own URL from the POSTGRES_* values above.
DATABASE_URL=postgres://aiki:change-this-password@localhost:5432/aiki

# --- Secrets (required, generate unique random values) ---
RATE_LIMIT_SECRET=replace-with-a-random-secret
READ_HMAC_SECRET=replace-with-a-random-secret

# --- Public identity of this node (required for a public deployment) ---
# The public HTTPS origin and host name of your node. Federation actor IDs and
# canonical URLs are derived from these; do not change them after launch.
SITE_URL=http://localhost:3000
NODE_DOMAIN=localhost
# Host port the app binds to on 127.0.0.1. Put a TLS reverse proxy in front.
AIKI_HOST_PORT=3000
# Prebuilt image tag for compose.registry.yaml (e.g. a release like 1.2.11). Default: latest.
# AIKI_IMAGE_TAG=latest
# Reverse proxies (IPs or CIDR ranges) allowed to pass the client address in
# X-Real-IP, besides loopback. With Docker Compose the app sees the Docker
# gateway, so set this to the bridge range, e.g. 172.16.0.0/12.
AIKI_TRUSTED_PROXIES=
# Public URL for publisher questions and corrections, shown on /node.
PUBLISHER_CONTACT_URL=

# --- Node mesh ---
# Central directory this node announces itself to. Set it to your own node's
# SITE_URL to run an independent mesh. The admin settings can override it.
AIKI_HUB_URL=https://aiki.wiki

# --- Fediverse (optional) ---
# Required before enabling federation. Store the signing JWK(s) in a secret manager; never commit them.
# A legacy single RSA JWK is accepted. For HTTP Signatures plus Object Integrity Proofs use
# {"rsa":{"privateKeyJwk":...,"publicKeyJwk":...},"ed25519":{"privateKeyJwk":...,"publicKeyJwk":...}}.
# FEDERATION_PRIVATE_KEY_JWK={"kty":"RSA","n":"…","e":"AQAB","d":"…","p":"…","q":"…","dp":"…","dq":"…","qi":"…"}

# --- Search engine discovery (optional) ---
# A random 8–128 character key (letters, digits, dashes), e.g. `openssl rand -hex 16`.
# The node serves /<key>.txt and notifies IndexNow. Leave empty to disable.
INDEXNOW_KEY=

# --- Email notifications (optional, Resend-compatible API) ---
# EMAIL_API_KEY=re_...
# EMAIL_FROM=AIKI <notifications@your-node.example>
# EMAIL_REPLY_TO=admin@your-node.example
# EMAIL_API_URL=https://api.resend.com/emails

# --- Machine translation (optional) ---
# Contact email sent to the MyMemory translation API for a higher free quota.
# MYMEMORY_CONTACT_EMAIL=admin@your-node.example

# --- AIKI Cloud task provider (optional) ---
# Disabled until an admin enables it in the project settings.
# AIKI_CLOUD_API_BASE=https://aiki.wiki/api/aiki-cloud/v1
# AIKI_CLOUD_BILLING_PATH=/billing
